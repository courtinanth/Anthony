{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "require('http').createServer((q,r)=>{const fs=require('fs'),p=require('path'),u=q.url==='/'?'/index.html':q.url,f=p.join('.',decodeURIComponent(u)),e=p.extname(f),m={'.html':'text/html','.css':'text/css','.js':'application/javascript','.png':'image/png','.jpg':'image/jpeg','.svg':'image/svg+xml','.json':'application/json','.avif':'image/avif','.webp':'image/webp','.ico':'image/x-icon'};fs.readFile(f,(err,d)=>{if(err){r.writeHead(404);r.end('Not found')}else{r.writeHead(200,{'Content-Type':m[e]||'text/plain'});r.end(d)}})}).listen(8080,()=>console.log('Server running on port 8080'))"],
      "port": 8080
    }
  ]
}
